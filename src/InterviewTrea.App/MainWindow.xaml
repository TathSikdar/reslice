<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InterviewTrea.App.MainWindow"
        Title="InterviewTrea"
        Height="800" Width="1000"
        Background="{StaticResource Brush.Chrome}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            RQ-1. Persistent and non-dismissible by construction: it is a row of the
            window's root grid with no close affordance and nothing that can collapse it.
        -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Regulatory.Background}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Thickness.Toolbar}">
            <TextBlock Text="RESEARCH AND DEMONSTRATION USE ONLY — NOT A MEDICAL DEVICE. NOT FOR DIAGNOSTIC USE."
                       Foreground="{StaticResource Brush.Regulatory.Text}"
                       FontFamily="{StaticResource Font.Interface}"
                       FontSize="{StaticResource Size.Text.Regulatory}"
                       HorizontalAlignment="Center" />
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Brush.Viewport}" />
    </Grid>
</Window>
