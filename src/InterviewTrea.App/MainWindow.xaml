<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:InterviewTrea.App.Views"
        xmlns:windowing="clr-namespace:InterviewTrea.Rendering.Windowing;assembly=InterviewTrea.Rendering"
        xmlns:core="clr-namespace:InterviewTrea.Core;assembly=InterviewTrea.Core"
        x:Class="InterviewTrea.App.MainWindow"
        Title="InterviewTrea"
        Height="900" Width="1300"
        Background="{StaticResource Brush.Chrome}"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!--
            An ItemTemplate rather than DisplayMemberPath. Style.ComboBox is fully
            retemplated, and its selection box draws SelectionBoxItem through
            SelectionBoxItemTemplate; measured behaviour is that DisplayMemberPath does not
            reach that template, so the closed box fell back to the record's ToString and
            read "WindowPreset { Name..." while the open list looked correct.
        -->
        <DataTemplate x:Key="Template.WindowPreset">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            RQ-1. Persistent and non-dismissible by construction: a row of the window's
            root grid with no close affordance and nothing that can collapse it.
        -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Regulatory.Background}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Thickness.Toolbar}">
            <TextBlock Text="{x:Static core:Disclaimer.Text}"
                       Foreground="{StaticResource Brush.Regulatory.Text}"
                       FontFamily="{StaticResource Font.Interface}"
                       FontSize="{StaticResource Size.Text.Regulatory}"
                       HorizontalAlignment="Center" />
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.Chrome}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Thickness.Toolbar}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Open Folder"
                        Style="{StaticResource Style.Button}"
                        Click="OnOpenFolder" />

                <!-- FR-310. Anatomical planes, middle of the volume, nothing drawn on it. -->
                <Button DockPanel.Dock="Left"
                        Content="Reset"
                        Margin="8,0,0,0"
                        Style="{StaticResource Style.Button}"
                        Click="OnReset" />

                <!--
                    FR-401 to FR-404. A tool takes the left button over from navigation while
                    it is selected, so None is the resting state and the entry the dropdown
                    returns to.
                -->
                <TextBlock DockPanel.Dock="Left"
                           Text="Measure:"
                           Margin="16,0,8,0"
                           Style="{StaticResource Style.Label}" />

                <ComboBox DockPanel.Dock="Left"
                          Width="110"
                          Style="{StaticResource Style.ComboBox}"
                          ItemsSource="{Binding MeasurementTools, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Tool}" />

                <!-- FR-407. Individual delete is hovering a measurement and pressing Delete. -->
                <Button DockPanel.Dock="Left"
                        Content="Clear"
                        Margin="8,0,0,0"
                        Style="{StaticResource Style.Button}"
                        Click="OnClearMeasurements" />

                <!-- FR-408. Patient millimetres and Hounsfield units, one row per measurement. -->
                <Button DockPanel.Dock="Left"
                        Content="Export CSV"
                        Margin="8,0,0,0"
                        Style="{StaticResource Style.Button}"
                        Click="OnExportCsv" />

                <!--
                    FR-409. The dropdown is the button: it names itself while closed and
                    lists what it can capture when opened, so choosing a target and running
                    the export are one gesture rather than a setting and then a command.
                    The RQ-1 disclaimer goes into the pixels of whatever it takes.
                -->
                <ComboBox DockPanel.Dock="Left"
                          x:Name="ExportPngTargets"
                          Width="120"
                          Margin="8,0,0,0"
                          Style="{StaticResource Style.ComboBox}"
                          Tag="Export PNG"
                          ItemsSource="{Binding ExportTargets}"
                          DisplayMemberPath="Name"
                          SelectionChanged="OnExportPng" />

                <!-- FR-207. Thickness is Shift+wheel over the slab pane, shown in its overlay. -->
                <ComboBox DockPanel.Dock="Right"
                          Width="110"
                          Style="{StaticResource Style.ComboBox}"
                          ItemsSource="{Binding SlabModes, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding SlabMode}" />

                <TextBlock DockPanel.Dock="Right"
                           Text="Slab:"
                           Margin="0,0,8,0"
                           Style="{StaticResource Style.Label}" />

                <ComboBox DockPanel.Dock="Right"
                          Width="140"
                          Margin="0,0,16,0"
                          Style="{StaticResource Style.ComboBox}"
                          ItemsSource="{x:Static windowing:WindowPreset.All}"
                          ItemTemplate="{StaticResource Template.WindowPreset}"
                          SelectedItem="{Binding SelectedPreset}"
                          Tag="{Binding WindowLabel}" />

                <TextBlock DockPanel.Dock="Right"
                           Text="Window:"
                           Margin="0,0,8,0"
                           Style="{StaticResource Style.Label}" />
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="2"
                     Style="{StaticResource Style.ProgressBar}"
                     Minimum="0" Maximum="1"
                     Value="{Binding LoadProgress}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <!-- FR-201. Four panes, hairline gutters, no chrome between them. -->
        <Grid Grid.Column="0" x:Name="ViewportGrid" Background="{StaticResource Brush.Border}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:ViewportControl x:Name="AxialPane" Grid.Row="0" Grid.Column="0"
                                   Margin="{StaticResource Thickness.ViewportGap}"
                                   DataContext="{Binding Viewports[0]}"
                                   Shell="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />

            <views:ViewportControl x:Name="CoronalPane" Grid.Row="0" Grid.Column="1"
                                   Margin="{StaticResource Thickness.ViewportGap}"
                                   DataContext="{Binding Viewports[1]}"
                                   Shell="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />

            <views:ViewportControl x:Name="SagittalPane" Grid.Row="1" Grid.Column="0"
                                   Margin="{StaticResource Thickness.ViewportGap}"
                                   DataContext="{Binding Viewports[2]}"
                                   Shell="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />

            <views:ViewportControl x:Name="SlabPane" Grid.Row="1" Grid.Column="1"
                                   Margin="{StaticResource Thickness.ViewportGap}"
                                   DataContext="{Binding Viewports[3]}"
                                   Shell="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />

            <!-- Covers the grid entirely while there is nothing to show. -->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                    Background="{StaticResource Brush.Viewport}"
                    Visibility="{Binding ShowStatusBanner, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Status}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           FontFamily="{StaticResource Font.Interface}"
                           FontSize="{StaticResource Size.Text.Body}"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
