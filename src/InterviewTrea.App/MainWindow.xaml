<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windowing="clr-namespace:InterviewTrea.Rendering.Windowing;assembly=InterviewTrea.Rendering"
        x:Class="InterviewTrea.App.MainWindow"
        Title="InterviewTrea"
        Height="800" Width="1000"
        Background="{StaticResource Brush.Chrome}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            RQ-1. Persistent and non-dismissible by construction: a row of the window's
            root grid with no close affordance and nothing that can collapse it.
        -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Regulatory.Background}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Thickness.Toolbar}">
            <TextBlock Text="RESEARCH AND DEMONSTRATION USE ONLY — NOT A MEDICAL DEVICE. NOT FOR DIAGNOSTIC USE."
                       Foreground="{StaticResource Brush.Regulatory.Text}"
                       FontFamily="{StaticResource Font.Interface}"
                       FontSize="{StaticResource Size.Text.Regulatory}"
                       HorizontalAlignment="Center" />
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.Chrome}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="{StaticResource Thickness.Toolbar}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="Open Folder"
                        Style="{StaticResource Style.Button}"
                        Click="OnOpenFolder" />

                <ComboBox DockPanel.Dock="Right"
                          x:Name="PresetSelector"
                          Width="140"
                          Style="{StaticResource Style.ComboBox}"
                          ItemsSource="{x:Static windowing:WindowPreset.All}"
                          DisplayMemberPath="Name"
                          SelectionChanged="OnPresetSelected" />

                <TextBlock DockPanel.Dock="Right"
                           Text="Window:"
                           Margin="0,0,8,0"
                           Style="{StaticResource Style.Label}" />
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="2"
                     Style="{StaticResource Style.ProgressBar}"
                     Minimum="0" Maximum="1"
                     Value="{Binding LoadProgress}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!--
            Every interaction in this iteration is a mouse gesture on this surface, so the
            handlers live on the Border: it is the hit-testable thing that fills the area,
            and the Image inside it moves under a transform that would otherwise take the
            gesture coordinates with it.
        -->
        <Border Grid.Row="3"
                x:Name="Viewport"
                Background="{StaticResource Brush.Viewport}"
                ClipToBounds="True"
                Focusable="True"
                MouseWheel="OnViewportMouseWheel"
                MouseDown="OnViewportMouseDown"
                MouseMove="OnViewportMouseMove"
                MouseUp="OnViewportMouseUp">
            <Grid>
                <!--
                    The rendered slice. Stretch is Uniform so the image is never distorted
                    to fill; the bitmap itself carries the aspect correction, through the
                    DPI it is created with (see MainWindow.xaml.cs).
                -->
                <Image x:Name="SliceImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True">
                    <Image.RenderTransform>
                        <MatrixTransform x:Name="ViewTransform" />
                    </Image.RenderTransform>
                </Image>

                <TextBlock Text="{Binding Status}"
                           Visibility="{Binding ShowStatusBanner, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           FontFamily="{StaticResource Font.Interface}"
                           FontSize="{StaticResource Size.Text.Body}"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="12"
                            Visibility="{Binding HasVolume, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SliceLabel}" Style="{StaticResource Style.Overlay}" />
                    <TextBlock Text="{Binding WindowLabel}" Style="{StaticResource Style.Overlay}" />
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource Style.Overlay}"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
