<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        The only place colours, sizes and control styles are allowed to live. Views
        reference resources and never literal values, so the reading-room palette can be
        judged in one file rather than reconstructed from thirty call sites.

        The palette is dark because the image is the point. A CT slice is greyscale over
        a large dynamic range, and the eye judges grey relative to what surrounds it - a
        light chrome raises the perceived black floor and flattens the contrast the
        window/level transform just worked to produce.
    -->

    <!-- Image area. Exactly black, not near-black: any lift here costs real contrast. -->
    <SolidColorBrush x:Key="Brush.Viewport" Color="#000000" />

    <SolidColorBrush x:Key="Brush.Chrome" Color="#121212" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2A2A2A" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#8A8A8A" />

    <!-- One accent, used sparingly: interactive state and measurement annotation. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#E0A030" />

    <!-- Plane identity. These stay the same wherever a plane is named (Iteration 3). -->
    <SolidColorBrush x:Key="Brush.Plane.Axial" Color="#E05050" />
    <SolidColorBrush x:Key="Brush.Plane.Coronal" Color="#50C070" />
    <SolidColorBrush x:Key="Brush.Plane.Sagittal" Color="#5090E0" />

    <!-- RQ-1. Deliberately not alarming: it must be permanent and unmissable, not loud. -->
    <SolidColorBrush x:Key="Brush.Regulatory.Background" Color="#2A2118" />
    <SolidColorBrush x:Key="Brush.Regulatory.Text" Color="#E0A030" />

    <FontFamily x:Key="Font.Interface">Segoe UI</FontFamily>

    <!--
        Every numeric readout. Proportional digits change width as the value changes, so
        a slice counter jitters horizontally while you scroll; monospaced digits do not.
    -->
    <FontFamily x:Key="Font.Numeric">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="Size.Text.Body">12</sys:Double>
    <sys:Double x:Key="Size.Text.Overlay">12</sys:Double>
    <sys:Double x:Key="Size.Text.Regulatory">11</sys:Double>
    <sys:Double x:Key="Size.Border.Hairline">1</sys:Double>
    <sys:Double x:Key="Opacity.Overlay">0.7</sys:Double>

    <sys:Double x:Key="Size.Text.Marker">11</sys:Double>
    <sys:Double x:Key="Size.Text.Measurement">15</sys:Double>
    <sys:Double x:Key="Size.Crosshair">1</sys:Double>
    <sys:Double x:Key="Opacity.Crosshair">0.85</sys:Double>
    <sys:Double x:Key="Opacity.Marker">0.55</sys:Double>

    <!-- Measurement outlines. Heavier than a crosshair arm: an arm is a reference line
         you look past, an outline is the thing you are looking at. Two and a half rather
         than the crosshair's hairline: amber on mid-grey parenchyma at one pixel is legible
         on a desk and gone on a projector. -->
    <sys:Double x:Key="Size.Measurement">2.5</sys:Double>

    <Thickness x:Key="Thickness.Hairline">1</Thickness>
    <Thickness x:Key="Thickness.Overlay">8</Thickness>
    <Thickness x:Key="Thickness.ViewportGap">1</Thickness>

    <Thickness x:Key="Thickness.Toolbar">8,6,8,6</Thickness>
    <Thickness x:Key="Thickness.Control">10,4,10,4</Thickness>
    <CornerRadius x:Key="CornerRadius.Control">2</CornerRadius>

    <Style x:Key="Style.Button" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Control}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Interface}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadius.Control}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Interface}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        A halo, not a drop shadow: zero offset, small blur, pure black. Overlay text sits
        on top of the image, and 700 HU bone renders as white - grey-on-white is
        unreadable, which makes an orientation marker that is present but invisible over
        exactly the anatomy you are looking at. Offsetting this would be a shadow and the
        project's visual rules rule those out; a symmetric dark edge is the same thing
        every workstation does for the same reason.
    -->
    <DropShadowEffect x:Key="Effect.TextHalo" Color="Black" ShadowDepth="0" BlurRadius="3" Opacity="1" />

    <!--
        The same halo, wider. A drop shadow can only be as opaque as the glyph casting it,
        so the way to make amber survive 700 HU cortical bone is a heavier glyph throwing a
        wider shadow, not a darker colour - the accent is fixed by the visual rules and a
        second colour for measurements over bright tissue would mean the annotation changed
        appearance depending on what was underneath it.
    -->
    <DropShadowEffect x:Key="Effect.TextHalo.Strong" Color="Black" ShadowDepth="0" BlurRadius="6" Opacity="1" />

    <!-- Overlays sit over the image and must never compete with it (Phase 1 visual rules). -->
    <Style x:Key="Style.Overlay" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Overlay}" />
        <Setter Property="Opacity" Value="{StaticResource Opacity.Overlay}" />
        <Setter Property="Effect" Value="{StaticResource Effect.TextHalo}" />
    </Style>

    <!--
        FR-204 edge markers. Fainter than the readouts on purpose: they are a constant
        reassurance rather than a value anyone reads, and at full strength four letters
        round every pane is visual noise over the image.
    -->
    <Style x:Key="Style.Marker" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Interface}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Marker}" />
        <Setter Property="Opacity" Value="{StaticResource Opacity.Marker}" />
        <Setter Property="Margin" Value="{StaticResource Thickness.Overlay}" />
        <Setter Property="Effect" Value="{StaticResource Effect.TextHalo}" />
    </Style>

    <!--
        Measurement readouts. The accent colour, because a measurement is the one thing on
        screen the user put there themselves, and the same halo as the overlays so a number
        stays legible over both 700 HU bone and black air.
    -->
    <Style x:Key="Style.Measurement" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Measurement}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Effect" Value="{StaticResource Effect.TextHalo.Strong}" />
    </Style>

    <Style x:Key="Style.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Interface}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Control}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Border}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Scrollbars. The stock WPF one is light grey with arrow buttons at both ends and is
        the last piece of Windows chrome visible in a dark reading room. Retemplated to a
        thumb and nothing else: the arrows step by a line at a time, which nobody uses, and
        each one is a control that would have to be explained.
    -->
    <Style x:Key="Style.ScrollBar.Page" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <!-- Transparent rather than absent: paging still works, it just has no chrome. -->
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar"
                            Background="{StaticResource Brush.Border}"
                            CornerRadius="{StaticResource CornerRadius.Control}"
                            Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit, with no key: every scrollbar in the application, wherever it appears. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource Style.ScrollBar.Page}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Style.ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource Style.ScrollBar.Page}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--
                            A horizontal bar is the same template turned: the track runs the
                            other way and the fixed dimension moves from Width to Height.
                        -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Height" Value="10" />
                            <Setter Property="MinHeight" Value="10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        FR-102's series picker, and nothing else so far. Deliberately plain: it is a list
        you read once when a folder holds more than one series, and it should look like the
        rest of the chrome rather than like part of the image.
    -->
    <Style x:Key="Style.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Hairline}" />
    </Style>

    <Style x:Key="Style.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Control}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Border}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Border}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Fully retemplated rather than restyled. The stock WPF ComboBox draws its own light
        chrome in the toggle button and popup, and Background/Foreground setters do not
        reach it - the control would stay white on an otherwise black reading room.
    -->
    <Style x:Key="Style.ComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Interface}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Text.Body}" />
        <Setter Property="Padding" Value="{StaticResource Thickness.Control}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Style.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{StaticResource Brush.Panel}"
                                            BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CornerRadius.Control}">
                                        <Path x:Name="Arrow"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Data="M 0 0 L 8 0 L 4 5 Z"
                                              Fill="{StaticResource Brush.Text.Secondary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Brush.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <!--
                            What the box says when nothing is selected. FR-306 calls the
                            series' own window an initial preset, but it is rarely one of the
                            five FR-305 names - LIDC-IDRI-0001 arrives at W1600/L-600 against
                            a Lung preset of W1500 - so the selection is legitimately empty
                            and the box read blank. The owner puts the fallback text in Tag;
                            a combo that leaves Tag unset shows nothing, as before.
                        -->
                        <TextBlock x:Name="Placeholder"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="None"
                               Focusable="False">
                            <Border Background="{StaticResource Brush.Panel}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--
                            SelectedItem rather than SelectionBoxItem: with no selection the
                            latter is the empty string rather than null, so a null trigger on
                            it would never fire.
                        -->
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="2" />
    </Style>

</ResourceDictionary>
