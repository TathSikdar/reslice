<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InterviewTrea.App.Views.SeriesPromptWindow"
        Title="Choose a series"
        Height="320" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Chrome}">

    <Grid Margin="{StaticResource Thickness.Overlay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="This folder holds more than one series. Pick the one to open."
                   Style="{StaticResource Style.Label}"
                   Margin="0,0,0,8" />

        <!--
            DI-1. Description, modality and slice count are enough to choose between
            series and carry nothing identifying: PatientName and PatientID are read on
            load but never reach a screen, here or in a viewport.
        -->
        <ListBox Grid.Row="1"
                 x:Name="SeriesList"
                 Style="{StaticResource Style.ListBox}"
                 ItemContainerStyle="{StaticResource Style.ListBoxItem}"
                 MouseDoubleClick="OnAccept">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Description}"
                                   FontFamily="{StaticResource Font.Interface}"
                                   FontSize="{StaticResource Size.Text.Body}" />
                        <TextBlock Text="{Binding Detail}"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   FontSize="{StaticResource Size.Text.Marker}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Style="{StaticResource Style.Button}" Click="OnCancel" />
            <Button Content="Open" Margin="8,0,0,0" Style="{StaticResource Style.Button}" Click="OnAccept" />
        </StackPanel>
    </Grid>
</Window>
