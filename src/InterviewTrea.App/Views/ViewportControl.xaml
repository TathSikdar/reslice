<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:InterviewTrea.App.Views"
             x:Class="InterviewTrea.App.Views.ViewportControl"
             x:Name="Root">

    <UserControl.Resources>
        <views:ResourceKeyConverter x:Key="ResourceKey" />
    </UserControl.Resources>

    <!--
        Every gesture lands on this border rather than on the image: it is the hit-testable
        thing that fills the pane, and the scene inside it moves under a transform that
        would otherwise take the gesture coordinates with it.
    -->
    <Border x:Name="Host"
            Background="{StaticResource Brush.Viewport}"
            BorderBrush="{Binding BorderBrushKey, Converter={StaticResource ResourceKey}}"
            BorderThickness="{StaticResource Thickness.Hairline}"
            ClipToBounds="True"
            Focusable="True"
            SizeChanged="OnHostSizeChanged"
            MouseWheel="OnMouseWheel"
            MouseDown="OnMouseDown"
            MouseMove="OnMouseMove"
            MouseUp="OnMouseUp"
            MouseLeave="OnMouseLeave">

        <Grid>
            <!--
                The scene is sized in plane pixels and carries one matrix that does fit,
                zoom and pan together. Drawing the crosshair inside it means the lines are
                positioned in the same coordinates the renderer works in - no separate
                screen-space arithmetic to keep in step, and they follow zoom and pan for
                free.
            -->
            <Canvas x:Name="Scene"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <Canvas.RenderTransform>
                    <MatrixTransform x:Name="ViewTransform" />
                </Canvas.RenderTransform>

                <Image x:Name="SliceImage" Canvas.Left="0" Canvas.Top="0" />

                <Line x:Name="VerticalLine"
                      Stroke="{Binding VerticalLineBrushKey, Converter={StaticResource ResourceKey}}"
                      Opacity="{StaticResource Opacity.Crosshair}" />

                <Line x:Name="HorizontalLine"
                      Stroke="{Binding HorizontalLineBrushKey, Converter={StaticResource ResourceKey}}"
                      Opacity="{StaticResource Opacity.Crosshair}" />

                <!--
                    FR-401 to FR-404. Inside the transform for the same reason the crosshair
                    is: a measurement is a fact about the plane, so it is drawn in plane
                    pixels and follows zoom and pan without a second copy of the geometry.
                    Its own canvas so redrawing is a Clear rather than a search through the
                    scene for shapes that used to be measurements.
                -->
                <Canvas x:Name="Annotations" />
            </Canvas>

            <!-- FR-204. Outside the transform, so they stay pinned to the pane. -->
            <TextBlock Text="{Binding TopMarker}" Style="{StaticResource Style.Marker}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" />
            <TextBlock Text="{Binding BottomMarker}" Style="{StaticResource Style.Marker}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding LeftMarker}" Style="{StaticResource Style.Marker}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RightMarker}" Style="{StaticResource Style.Marker}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource Style.Overlay}"
                       Foreground="{Binding BorderBrushKey, Converter={StaticResource ResourceKey}}"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="{StaticResource Thickness.Overlay}" />

            <!-- FR-405. Top right, clear of the four edge markers and of FR-205's block. -->
            <TextBlock Text="{Binding HoverLabel, ElementName=Root}"
                       Style="{StaticResource Style.Overlay}"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="{StaticResource Thickness.Overlay}" />

            <!-- FR-205: position, window and zoom. DI-1: nothing identifying the patient. -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="{StaticResource Thickness.Overlay}">
                <TextBlock Text="{Binding PositionLabel}" Style="{StaticResource Style.Overlay}" />
                <TextBlock Text="{Binding Shell.WindowLabel, ElementName=Root}" Style="{StaticResource Style.Overlay}" />
                <TextBlock Text="{Binding ZoomLabel, ElementName=Root}" Style="{StaticResource Style.Overlay}"
                           Foreground="{StaticResource Brush.Text.Secondary}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
