<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:InterviewTrea.App.Views"
                    xmlns:histogram="clr-namespace:InterviewTrea.Applications.Histogram;assembly=InterviewTrea.Applications.Histogram">

    <!--
        FR-504. Where the shell learns what an application's tool panel looks like.

        A plugin ships a view model and the shell finds its template by type. That is the
        one place the seam is thinner than it looks: an application cannot yet bring its own
        control. Making that possible means a plugin shipping a WPF resource dictionary,
        which is worth deciding when there is a second application to justify it.
    -->
    <views:ScaleConverter x:Key="Scale" />

    <DataTemplate DataType="{x:Type histogram:HistogramPanelViewModel}">
        <DockPanel Margin="{StaticResource Thickness.Overlay}">
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Summary}"
                       Style="{StaticResource Style.Label}"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       FontFamily="{StaticResource Font.Numeric}"
                       Margin="0,0,0,6" />

            <!-- The selected band, which is also what the overlay names on the image. -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Selected.Label}"
                       Style="{StaticResource Style.Label}"
                       Foreground="{StaticResource Brush.Accent}"
                       FontFamily="{StaticResource Font.Numeric}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />

            <ListBox Style="{StaticResource Style.ListBox}"
                     ItemContainerStyle="{StaticResource Style.ListBoxItem}"
                     ItemsSource="{Binding Bars}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Label}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Low}"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontFamily="{StaticResource Font.Numeric}"
                                       FontSize="{StaticResource Size.Text.Marker}"
                                       TextAlignment="Right"
                                       Margin="0,0,6,0" />

                            <!--
                                Scaled against the busiest bin, not the total: air and soft
                                tissue outnumber bone by orders of magnitude, and bars drawn
                                as a share of the whole volume would leave bone invisible.
                            -->
                            <Rectangle Grid.Column="1"
                                       Height="7"
                                       HorizontalAlignment="Left"
                                       Fill="{StaticResource Brush.Accent}"
                                       Width="{Binding OfPeak, Converter={StaticResource Scale}, ConverterParameter=170}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
