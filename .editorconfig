root = true

[*]
end_of_line = crlf
insert_final_newline = true
indent_style = space

[*.cs]
indent_size = 4

[*.{csproj,props,json,yml,xml}]
indent_size = 2

# Test method names use the Method_Scenario_ExpectedResult convention, which reads
# far better in a failure report than a camel-cased run-on. CA1707 exists to keep
# underscores out of a library's public API surface; a test method is not that.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
